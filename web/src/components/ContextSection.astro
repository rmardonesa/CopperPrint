---
const cards = [
  {
    heading: 'Pipeline',
    body: 'ETL completo en Python que extrae datos públicos de la Cochilco, los transforma en un modelo en SQL Server conectado a BigQuery',
  },
  {
    heading: 'Resultado',
    body: 'Dashboard interactivo en Power BI sincronizado por DirectQuery a Google Cloud, con KPIs, DAX y seis vistas analíticas',
  },
];
---

<section class="context">
  <div class="context__inner">
    <h2 class="context__heading">Sobre el proyecto</h2>
    <div class="context__grid">
      {cards.map(({ heading, body }) => (
        <article class="context__card">
          <h3 class="context__card-title">{heading}</h3>
          <p class="context__card-body">{body}</p>
        </article>
      ))}
    </div>

    <div class="context__env">
      <span class="context__env-item">Workspace: Linux Debian 12 · Conda environment · Docker Compose · Microsoft SQL Server</span>
      <span class="context__env-sep">·</span>
      <span class="context__env-item">LazyDocker + VSCode + DBeaver · Datasource desplegada en Google Cloud BigQuery</span>
    </div>
  </div>
</section>

<style lang="scss">
  .context {
    padding: 5rem 1.5rem;
    border-bottom: 1px solid var(--border);

    &__inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    &__heading {
      font-size: 1.75rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    &__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.25rem;
    }

    &__card {
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      transition: border-color 0.2s;

      &:hover { border-color: var(--copper); }
    }

    &__card-title {
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--copper);
    }

    &__card-body {
      font-size: 0.95rem;
      color: var(--muted);
      line-height: 1.75;
    }
  }

  .context__env {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.82rem;
    color: var(--muted);
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background-color: var(--surface);
  }

  .context__env-sep { color: var(--border); }
</style>
