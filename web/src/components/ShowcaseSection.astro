---
const items = [
  {
    src:   '/screenshots/dbeaver-vistas.png',
    title: 'Vistas analíticas en DBeaver',
    tag:   'SQL Server · T-SQL',
  },
  {
    src:   '/screenshots/lazydocker.png',
    title: 'Entorno Docker con lazydocker',
    tag:   'Docker Compose · SQL Server',
  },
  {
    src:   '/screenshots/etl-diagrama.png',
    title: 'Flujo ETL',
    tag:   'Python · pandas · SQLAlchemy',
  },
  {
    src:   '/screenshots/powerbi-relaciones.png',
    title: 'Modelo estrella en Power BI',
    tag:   'DAX · Cardinalidad · DirectQuery',
  },
];
---

<section class="showcase">
  <div class="showcase__inner">
    <h2 class="showcase__heading">El sistema en acción</h2>
    <div class="showcase__grid">
      {items.map(({ src, title, tag }) => (
        <figure class="showcase__card">
          <div class="showcase__img-wrap">
            <img src={src} alt={title} class="showcase__img" loading="lazy" />
          </div>
          <figcaption class="showcase__caption">
            <span class="showcase__caption-title">{title}</span>
            <span class="showcase__caption-tag">{tag}</span>
          </figcaption>
        </figure>
      ))}
    </div>

  </div>
</section>

<style lang="scss">
  .showcase {
    padding: 5rem 1.5rem;
    border-bottom: 1px solid var(--border);

    &__inner {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    &__heading {
      font-size: 1.75rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    &__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;

      @media (max-width: 640px) {
        grid-template-columns: 1fr;
      }
    }

    &__card {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0;
      background-color: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      transition: border-color 0.2s;

      &:hover { border-color: var(--copper); }
    }

    &__img-wrap {
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background-color: var(--bg);
    }

    &__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top left;
      display: block;
      transition: transform 0.35s ease;

      .showcase__card:hover & {
        transform: scale(1.03);
      }
    }

    &__caption {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      padding: 1rem 1.25rem;
      border-top: 1px solid var(--border);
    }

    &__caption-title {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text);
    }

    &__caption-tag {
      font-size: 0.72rem;
      color: var(--muted);
      letter-spacing: 0.04em;
    }
  }

</style>
