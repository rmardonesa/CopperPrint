---
---

<header class="hero">
  <div class="hero__inner">
    <span class="hero__label">ETL Flujo de datos end-to-end</span>
    <h1 class="hero__title"><span class="hero__copper">Copper</span>Print</h1>
    <p class="hero__subtitle">
      Producción y huella hídrica de la minería del cobre en Chile
    </p>
    <nav class="hero__links">
      <a href="#dashboard" class="btn btn--primary">Ver dashboard</a>
      <a
        href="https://github.com/rmardonesa/CopperPrint"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--ghost"
      >GitHub</a>
    </nav>
  </div>
</header>

<style lang="scss">
  .hero {
    padding: 3.5rem 1.5rem 2.5rem;
    text-align: center;
    background: radial-gradient(ellipse 70% 80% at 50% 0%, rgba(184,115,51,0.07) 0%, transparent 70%);
    border-bottom: 1px solid var(--border);

    &__inner {
      max-width: 680px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
    }

    &__label {
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      border: 1px solid var(--border);
      padding: 0.3rem 0.85rem;
      border-radius: 999px;
    }

    &__title {
      font-size: clamp(2.5rem, 8vw, 4rem);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.03em;
    }

    &__copper { color: var(--copper); }

    &__subtitle {
      font-size: 1rem;
      color: var(--muted);
      line-height: 1.6;
    }

    &__links {
      display: flex;
      gap: 0.75rem;
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.4rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s, background-color 0.15s;

    &--primary {
      background-color: var(--copper);
      color: #fff;
      &:hover { opacity: 0.85; text-decoration: none; }
    }

    &--ghost {
      border: 1px solid var(--border);
      color: var(--text);
      &:hover { background-color: var(--surface); text-decoration: none; }
    }
  }
</style>
